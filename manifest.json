{
  "manifest_version": 3,
  "name": "Japanese Reading Helper (dev)",
  "version": "0.1.0",
  "description": "Highlight Japanese text on any page. Kanji mode: real KANJIDIC2 lookups. Goi mode: word lookup, still fake data (Jitendex not wired up yet).",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "utils/extractKanji.js",
        "services/kanji/kanjiIndex.js",
        "services/dictionary/fakeGoiLookup.js",
        "content/mode.js",
        "content/overlay.js",
        "content/selectionDetector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dict/kanjidic/normalized.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
