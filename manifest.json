{
  "manifest_version": 3,
  "name": "Japanese Reading Helper (dev)",
  "version": "0.2.0",
  "description": "Highlight Japanese text on any page. Three modes (Alt+K to cycle): Kanji (real KANJIDIC2), JP-EN (Jitendex, still fake data), JP-JP (monolingual, still fake data — no source picked yet).",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "utils/extractKanji.js",
        "services/kanji/kanjiIndex.js",
        "services/dictionary/fakeJpEnLookup.js",
        "services/dictionary/fakeJpJpLookup.js",
        "content/mode.js",
        "content/overlay.js",
        "content/selectionDetector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dict/kanjidic/normalized.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
